[Unit]
Description=SMS Gate - card based SMS relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smsgate
Group=smsgate
WorkingDirectory=/opt/smsgate
Environment=SMSGATE_ROOT=/opt/smsgate
Environment=SMSGATE_PORT=8861
Environment=SMSGATE_HOST=127.0.0.1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smsgate/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8861 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smsgate/data /opt/smsgate/logs
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target